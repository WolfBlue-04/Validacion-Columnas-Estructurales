        }
      ],
      "Replication": "Disabled",
      "Description": "Obtiene todos los elementos de la categoría especificada en el modelo"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Elementos recibidos desde Dynamo\r\nentrada = IN[0]\r\n\r\nif not isinstance(entrada, list):\r\n    entrada = [entrada]\r\n\r\nelementos = [UnwrapElement(e) for e in entrada if e is not None]\r\n\r\nregistros = []\r\n\r\nfor el in elementos:\r\n\r\n    # ID\r\n    id_elemento = el.Id.Value\r\n\r\n    # Tipo\r\n    tipo = doc.GetElement(el.GetTypeId())\r\n\r\n    if tipo:\r\n        parametro_tipo = tipo.get_Parameter(\r\n            BuiltInParameter.SYMBOL_NAME_PARAM\r\n        )\r\n        nombre_tipo = parametro_tipo.AsString() if parametro_tipo else \"\"\r\n    else:\r\n        nombre_tipo = \"\"\r\n\r\n    # Nivel\r\n    nivel_el = doc.GetElement(el.LevelId)\r\n    nivel = nivel_el.Name if nivel_el else \"\"\r\n\r\n    # Clasificación\r\n    if nombre_tipo.startswith(\"CC\"):\r\n        clasificacion = \"Hormigon\"\r\n\r\n    elif nombre_tipo.startswith(\"W\"):\r\n        clasificacion = \"Acero W\"\r\n\r\n    elif nombre_tipo.startswith(\"HSS\"):\r\n        clasificacion = \"Acero HSS\"\r\n\r\n    elif nombre_tipo.startswith(\"SC_\"):\r\n        clasificacion = \"Pilar de referencia\"\r\n\r\n    else:\r\n        clasificacion = \"Otro tipo\"\r\n\r\n    registros.append([\r\n        id_elemento,\r\n        nombre_tipo,\r\n        nivel,\r\n        clasificacion\r\n    ])\r\n\r\nencabezados = [\r\n    \"Id\",\r\n    \"Tipo\",\r\n    \"Nivel\",\r\n    \"Clasificacion\"\r\n]\r\n\r\nOUT = [encabezados] + registros",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "394ff1e7c41e4a9d9bc777a188fd855d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "8816cc04dad64ab2b853f57b98e8b8c2",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "10dd10764ff344dfa2ef10603049ff20",
          "Name": "OUT",
          "Description": "Resultado de la secuencia de comandos de Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ejecuta una secuencia de comandos de Python incrustada."
    },
